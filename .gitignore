# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local environment
.env

# Data artifacts (reproducible via `python -m src.data.fetch_binance`)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model artifacts (reproducible via `python -m src.models.train`)
models/*
!models/.gitkeep

# Signal-log directory: the CSV records ARE tracked (they are the project's
# non-reproducible forward-test + retrain-audit trail, recorded before outcomes
# were known). Only operational/debug output from the scheduled recorder is
# ignored.
data/signal_log/*.out
# Live 1-minute indicator scoreboard + paper/risk-trading runs: high-churn,
# per-session operational state (NOT the model's tracked forward-test record),
# so they are ignored to avoid constant git noise while the dashboard runs.
data/signal_log/live_preds_*.csv
data/signal_log/paper_trade_*.json
data/signal_log/risk_trade_*.json
